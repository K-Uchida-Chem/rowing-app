{
  // 型チェックは、画面から切り離した集計ロジック(src/report)にだけ JSDoc の型で適用する
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/report/**/*.js"],
  "exclude": ["src/report/**/*.test.js"]
}
